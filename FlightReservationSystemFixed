import java.util.Scanner;

// Class representing a Flight
class Flight {
    String flightNumber;
    String source;
    String destination;
    String date;
    String time;
    double price;
    int availableSeats;

    public Flight(String flightNumber, String source, String destination, String date, String time, double price, int availableSeats) {
        this.flightNumber = flightNumber;
        this.source = source;
        this.destination = destination;
        this.date = date;
        this.time = time;
        this.price = price;
        this.availableSeats = availableSeats;
    }
}

// Class representing a Booking transaction
class Booking {
    String bookingId;
    Flight flight;
    int numPassengers;
    double totalAmount;

    public Booking(String bookingId, Flight flight, int numPassengers) {
        this.bookingId = bookingId;
        this.flight = flight;
        this.numPassengers = numPassengers;
        this.totalAmount = numPassengers * flight.price;
    }
}

// Main Flight Reservation System
public class FlightReservationSystemFixed {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int bookingCounter = 1001;

        // Initialize sample flights
        Flight[] flights = new Flight[4];
        flights[0] = new Flight("AI101", "Chennai", "Delhi", "2026-11-01", "06:30", 5500.0, 45);
        flights[1] = new Flight("6E202", "Bengaluru", "Mumbai", "2026-11-01", "14:15", 4200.0, 30);
        flights[2] = new Flight("SG303", "Chennai", "Kolkata", "2026-11-02", "09:00", 4800.0, 15);
        flights[3] = new Flight("UK404", "Delhi", "Bengaluru", "2026-11-03", "18:45", 6100.0, 20);

        Booking[] bookings = new Booking[100];
        int bookingCount = 0;

        while (true) {
            System.out.println("\n========== FLIGHT RESERVATION SYSTEM ==========");
            System.out.println("1. Display Available Flights");
            System.out.println("2. Search Flights by Source");
            System.out.println("3. Search Flights by Destination");
            System.out.println("4. Search Flights by Travel Date");
            System.out.println("5. Select a Flight");
            System.out.println("6. Enter Passenger Details");
            System.out.println("7. Book Tickets");
            System.out.println("8. Cancel a Booking");
            System.out.println("9. Search Booking using Booking ID");
            System.out.println("10. Display Available Seats");
            System.out.println("11. Calculate Ticket Amount");
            System.out.println("12. Display Booking Details");
            System.out.println("13. Exit");
            System.out.print("Enter your choice (1-13): ");

            int choice = Integer.parseInt(scanner.nextLine());

            if (choice == 1) {
                System.out.printf("%-10s %-12s %-12s %-12s %-8s %-11s %-5s%n", "Flight", "Source", "Destination", "Date", "Time", "Price", "Seats");
                System.out.println("-------------------------------------------------------------------");
                for (int i = 0; i < flights.length; i++) {
                    Flight f = flights[i];
                    System.out.printf("%-10s %-12s %-12s %-12s %-8s ₹%-10.2f %-5d%n", f.flightNumber, f.source, f.destination, f.date, f.time, f.price, f.availableSeats);
                }
            } else if (choice == 2) {
                System.out.print("Enter Source City: ");
                String src = scanner.nextLine();
                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].source.equalsIgnoreCase(src)) {
                        Flight f = flights[i];
                        System.out.printf("%-10s %-12s %-12s %-12s %-8s ₹%-10.2f %-5d%n", f.flightNumber, f.source, f.destination, f.date, f.time, f.price, f.availableSeats);
                    }
                }
            } else if (choice == 3) {
                System.out.print("Enter Destination City: ");
                String dest = scanner.nextLine();
                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].destination.equalsIgnoreCase(dest)) {
                        Flight f = flights[i];
                        System.out.printf("%-10s %-12s %-12s %-12s %-8s ₹%-10.2f %-5d%n", f.flightNumber, f.source, f.destination, f.date, f.time, f.price, f.availableSeats);
                    }
                }
            } else if (choice == 4) {
                System.out.print("Enter Travel Date (YYYY-MM-DD): ");
                String date = scanner.nextLine();
                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].date.equalsIgnoreCase(date)) {
                        Flight f = flights[i];
                        System.out.printf("%-10s %-12s %-12s %-12s %-8s ₹%-10.2f %-5d%n", f.flightNumber, f.source, f.destination, f.date, f.time, f.price, f.availableSeats);
                    }
                }
            } else if (choice == 5 || choice == 6 || choice == 7) {
                System.out.print("Enter Flight Number to book: ");
                String flightNo = scanner.nextLine();
                Flight selectedFlight = null;

                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].flightNumber.equalsIgnoreCase(flightNo)) {
                        selectedFlight = flights[i];
                    }
                }

                if (selectedFlight == null) {
                    System.out.println("Flight not found.");
                } else if (choice == 5) {
                    System.out.println("Flight " + selectedFlight.flightNumber + " selected.");
                } else if (choice == 6) {
                    System.out.println("Passenger details will be collected during booking.");
                } else if (choice == 7) {
                    System.out.print("Enter number of passengers: ");
                    int numPassengers = Integer.parseInt(scanner.nextLine());
                    System.out.print("Enter Passenger Name: ");
                    String name = scanner.nextLine();

                    if (numPassengers <= selectedFlight.availableSeats) {
                        selectedFlight.availableSeats -= numPassengers;
                        String bookingId = "BK" + bookingCounter++;

                        bookings[bookingCount++] = new Booking(bookingId, selectedFlight, numPassengers);

                        System.out.println("Booking Successful! Booking ID: " + bookingId);
                        System.out.println("Total Amount Calculated: ₹" + (numPassengers * selectedFlight.price));
                    } else {
                        System.out.println("Not enough seats available.");
                    }
                }
            } else if (choice == 8) {
                System.out.print("Enter Booking ID to cancel: ");
                String bId = scanner.nextLine();
                boolean found = false;

                for (int i = 0; i < bookingCount; i++) {
                    if (bookings[i].bookingId.equalsIgnoreCase(bId)) {
                        bookings[i].flight.availableSeats += bookings[i].numPassengers;
                        System.out.println("Booking " + bId + " cancelled.");
                        
                        for (int j = i; j < bookingCount - 1; j++) {
                            bookings[j] = bookings[j + 1];
                        }
                        bookingCount--;
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    System.out.println("Booking not found.");
                }
            } else if (choice == 9) {
                System.out.print("Enter Booking ID: ");
                String bId = scanner.nextLine();
                boolean found = false;

                for (int i = 0; i < bookingCount; i++) {
                    if (bookings[i].bookingId.equalsIgnoreCase(bId)) {
                        Booking b = bookings[i];
                        System.out.println("Booking Found - ID: " + b.bookingId + ", Flight: " + b.flight.flightNumber);
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    System.out.println("Booking not found.");
                }
            } else if (choice == 10) {
                System.out.print("Enter Flight Number: ");
                String flightNo = scanner.nextLine();
                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].flightNumber.equalsIgnoreCase(flightNo)) {
                        System.out.println("Available seats on Flight " + flightNo + ": " + flights[i].availableSeats);
                    }
                }
            } else if (choice == 11) {
                System.out.print("Enter Flight Number: ");
                String flightNo = scanner.nextLine();
                System.out.print("Enter number of passengers: ");
                int num = Integer.parseInt(scanner.nextLine());
                for (int i = 0; i < flights.length; i++) {
                    if (flights[i].flightNumber.equalsIgnoreCase(flightNo)) {
                        System.out.println("Total Amount: ₹" + (num * flights[i].price));
                    }
                }
            } else if (choice == 12) {
                System.out.print("Enter Booking ID: ");
                String bId = scanner.nextLine();
                boolean found = false;

                for (int i = 0; i < bookingCount; i++) {
                    if (bookings[i].bookingId.equalsIgnoreCase(bId)) {
                        Booking b = bookings[i];
                        System.out.println("\n--- Booking Details ---");
                        System.out.println("Booking ID: " + b.bookingId);
                        System.out.println("Flight Number: " + b.flight.flightNumber);
                        System.out.println("Source: " + b.flight.source);
                        System.out.println("Destination: " + b.flight.destination);
                        System.out.println("Passengers: " + b.numPassengers);
                        System.out.println("Total Amount: ₹" + b.totalAmount);
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    System.out.println("Booking not found.");
                }
            } else if (choice == 13) {
                System.out.println("Exiting system.");
                break;
            } else {
                System.out.println("Invalid choice.");
            }
        }
        scanner.close();
    }
}
